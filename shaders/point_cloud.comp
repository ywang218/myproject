#version 430 core

struct Point {
    vec4 pos;
    vec4 color;
};

layout(std430, binding = 0) buffer PointBuffer {
    Point points[];
};

uniform float uTime;

// 这里的 256 是每个工作组的大小，对应 DispatchCompute 时的除数
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    
    // 基础运动：正弦波
    float offset = sin(uTime + points[idx].pos.x * 0.5) * 0.01;
    points[idx].pos.y += offset;

    // 变色逻辑：根据高度改变 R 通道
    points[idx].color.r = (points[idx].pos.y + 5.0) / 10.0;
}