#version 430 core
layout (local_size_x = 256) in;

// ───────────────────────────────────────────────────────────────────────────
// 体素栅格 LOD + 重要性选点 (2-pass atomicMax「赢家」)
//
// 与 filter_voxel.comp 的区别：
//   filter_voxel.comp   —— CAS「先到先得」，每体素留任意一个点
//   本文件              —— 每体素留「score 最高」的点 (重要性 LOD)
//
// score 来源：inPoints[idx].pos.w (上游写入：原始强度 / 高度 / 预算好的梯度曲率)。
//   想算真·梯度需要邻居 → 必须在数据生成/预处理阶段算好塞进 pos.w，本 shader 只消费。
//
// 两趟 dispatch (uPass=0 投票，uPass=1 落地)，中间隔一个
//   glMemoryBarrier(GL_SHADER_STORAGE_BARRIER_BIT)。体素表每帧先清 0。
// ───────────────────────────────────────────────────────────────────────────

struct Point { vec4 pos; vec4 color; };

layout(std430, binding = 0) readonly  buffer InBuf      { Point inPoints[]; };
layout(std430, binding = 1) writeonly buffer OutBuf     { Point outPoints[]; };
layout(std430, binding = 2)           buffer IndirectBuf {
    uint vertexCount; uint instanceCount; uint firstVertex; uint baseInstance;
} indirect;
// 体素表：每槽存打包值 (score<<24 | idx)。每帧 dispatch 前清成 0。
layout(std430, binding = 3) buffer VoxelTable { uint voxelTable[]; };

uniform vec3  uEgoPos;
uniform uint  uTotalPoints;
uniform uint  uTableSize;
uniform float uMaxRange;
uniform uint  uPass;         // 0 = 投票(vote)，1 = 落地(emit)

// 打包：score 占高 8 位(256 级)，idx 占低 24 位(支持最多 16M 点)。
// atomicMax 比较整个 32 位 → score 高位主导，score 最大者胜；并列时 idx 大者胜。
const uint IDX_MASK = 0xFFFFFFu;   // 低 24 位

// 组内压缩共享变量 (仅 emit pass 使用)
shared uint groupCount;
shared uint groupOffset;
shared uint localIndices[256];

float voxelSize(float d) {                       // 距离 → 体素边长 = 分层 LOD
    if      (d < 20.0)  return 0.2;
    else if (d < 50.0)  return 0.5;
    else if (d < 100.0) return 1.5;
    else                return 4.0;
}
uint packVoxel(ivec3 c) {                        // 体素坐标 → 唯一 key (各轴 ±512)
    uvec3 u = uvec3(c + 512);
    return (u.x & 0x3FFu) | ((u.y & 0x3FFu) << 10) | ((u.z & 0x3FFu) << 20);
}
uint slotOf(uint key) { return (key * 2654435761u) % uTableSize; }

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint localIdx = gl_LocalInvocationID.x;

    // 两趟都先算出本点的体素槽与打包值，保证 vote / emit 落在同一槽
    bool valid = false;
    uint slot = 0u;
    uint packedKey = 0u;
    if (idx < uTotalPoints) {
        vec3 p = inPoints[idx].pos.xyz;
        float d = distance(p, uEgoPos);
        if (d <= uMaxRange) {
            valid = true;
            slot = slotOf(packVoxel(ivec3(floor(p / voxelSize(d)))));
            // score 来自 pos.w，量化到 8 位
            uint score = uint(clamp(inPoints[idx].pos.w, 0.0, 1.0) * 255.0);
            packedKey = (score << 24) | (idx & IDX_MASK);
        }
    }

    // ── Pass 0：投票 ── 每点把 packedKey atomicMax 进自己的体素槽
    if (uPass == 0u) {
        if (valid) atomicMax(voxelTable[slot], packedKey);
        return;
    }

    // ── Pass 1：落地 ── 自己是体素赢家才保留，再做组内压缩写出
    if (localIdx == 0u) groupCount = 0u;
    barrier();

    bool keep = false;
    if (valid) {
        uint winnerIdx = voxelTable[slot] & IDX_MASK;
        keep = (winnerIdx == (idx & IDX_MASK));
    }

    uint myLocalOffset = 0u;
    if (keep) {
        myLocalOffset = atomicAdd(groupCount, 1u);
        localIndices[myLocalOffset] = idx;
    }
    barrier();

    if (localIdx == 0u && groupCount > 0u) {
        groupOffset = atomicAdd(indirect.vertexCount, groupCount);
    }
    barrier();

    if (keep) {
        uint writeIdx = groupOffset + myLocalOffset;
        if (writeIdx < uTotalPoints) {
            outPoints[writeIdx] = inPoints[localIndices[myLocalOffset]];
        }
    }
}
